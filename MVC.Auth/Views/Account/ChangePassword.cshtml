@model MvcAuthDemo.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-md rounded-4">
            <div class="card-body p-4">
                <h4 class="fw-bold text-danger mb-1">Change Password</h4>
                <p class="text-muted small mb-4">Update your account credentials safely.</p>

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success bg-success-subtle text-success border-0 small py-2 mb-3">
                        @ViewBag.Message
                    </div>
                }

                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 bg-danger-subtle text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label text-secondary fw-semibold small"></label>
                        <input asp-for="CurrentPassword" class="form-control bg-light" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label text-secondary fw-semibold small"></label>
                        <input asp-for="NewPassword" class="form-control bg-light" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 fw-bold shadow-sm mt-3" style="background-color: #dc3545; border: none;">
                        Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>