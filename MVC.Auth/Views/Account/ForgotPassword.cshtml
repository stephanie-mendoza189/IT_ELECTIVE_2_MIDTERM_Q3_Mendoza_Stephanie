@model MvcAuthDemo.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #dc3545, #b02a37);">
                <h4 class="fw-bold mb-0">Reset Password</h4>
                <small class="text-white-50">Enter your email to receive a temporary pass</small>
            </div>
            <div class="card-body p-4 bg-white">
                @if (TempData["Notice"] != null)
                {
                    <div class="alert alert-danger bg-danger-subtle text-danger border-0 small py-2">
                        @TempData["Notice"]
                    </div>
                }

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-secondary fw-semibold small"></label>
                        <input asp-for="Email" class="form-control form-control-lg bg-light border-1" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold shadow-sm mt-2" style="background-color: #dc3545; border: none;">
                        Send Reset
                    </button>
                </form>
            </div>
            <div class="card-footer bg-light border-0 text-center py-3">
                <a asp-action="Login" class="text-secondary text-decoration-none small fw-semibold">← Back to Login</a>
            </div>
        </div>
    </div>
</div>